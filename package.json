{
	"name": "simple-image-convert",
	"version": "0.1.0",
	"description": "Convert and compress images to WebP in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "22.20.5",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"@jsquash/webp": "1.5.0"
	}
}
